# NestJS API 환경변수
PORT=3011
CORS_ORIGIN=http://localhost:3010
REPLAY_BUFFER_SIZE=50

# Claude CLI 바이너리 경로 (기본: PATH의 'claude')
# CLAUDE_BIN=/usr/local/bin/claude

# 에이전트가 API에 이벤트를 POST할 때 사용하는 URL
SYNAPSE_API_URL=http://localhost:3011

# WebSocket Redis adapter (멀티 인스턴스 스케일아웃)
# WS_REDIS_ENABLED=1
# WS_REDIS_URL=redis://localhost:6379
